<local:BaseWindow x:Class="NotaDog.Windows.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:NotaDog.Windows"
                  mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label Content="Default Documents Folder:"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="txtDocumentsFolder" Width="250" IsReadOnly="True"/>
                <Button Content="Browse..." Margin="5,0,0,0" Click="BrowseButton_Click"/>
            </StackPanel>
            <CheckBox x:Name="chkAlwaysOpenWithoutPrompt" Content="Always open documents without prompt" Margin="0,10,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Margin="5,0,0,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="75" Margin="5,0,0,0" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:BaseWindow>
