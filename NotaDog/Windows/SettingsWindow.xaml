<local:BaseWindow x:Class="NotaDog.Windows.SettingsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:NotaDog.Windows"
                  mc:Ignorable="d"
                  MinHeight="400" MinWidth="400">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Label Content="Default Documents Folder:"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="txtDocumentsFolder" Width="250" Margin="5,0,0,0" IsReadOnly="True"/>
                        <Button Content="Browse..." Margin="5,0,0,0" Click="BrowseButton_Click"/>
                    </StackPanel>
                    <Label Content="Confirmation Settings:" FontWeight="Bold" Margin="0,10,0,5"/>
                    <CheckBox x:Name="chkAlwaysOpenWithoutPrompt" Content="Always open documents without prompt" Margin="0,5,0,0"/>
                    <CheckBox x:Name="chkSkipCreateDocumentConfirmation" Content="Always create documents without prompt" Margin="0,5,0,0"/>
                    <CheckBox x:Name="chkSkipCancelConfigurationConfirmation" Content="Always cancel configuration without prompt" Margin="0,5,0,0"/>

                    <!-- Separator -->
                    <Separator Margin="0,10,0,10"/>

                    <!-- Notary Information -->
                    <Label Content="Notary Information:" FontWeight="Bold"/>

                    <Label Content="First Name:"/>
                    <TextBox x:Name="txtNotaryFirstName" Width="250"/>

                    <Label Content="Last Name:"/>
                    <TextBox x:Name="txtNotaryLastName" Width="250"/>

                    <Label Content="City:"/>
                    <TextBox x:Name="txtNotaryCity" Width="250"/>

                    <Label Content="Country:"/>
                    <TextBox x:Name="txtNotaryCountry" Width="250"/>

                    <Label Content="Office Name:"/>
                    <TextBox x:Name="txtNotaryOfficeName" Width="250"/>

                    <Label Content="Office Address:"/>
                    <TextBox x:Name="txtNotaryOfficeAddress" Width="250"/>

                    <Label Content="Authority City:"/>
                    <TextBox x:Name="txtNotaryAuthorityCity" Width="250"/>

                    <Label Content="Authority Country:"/>
                    <TextBox x:Name="txtNotaryAuthorityCountry" Width="250"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Margin="5,1,5,1" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="75" Margin="5,1,5,1" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</local:BaseWindow>
