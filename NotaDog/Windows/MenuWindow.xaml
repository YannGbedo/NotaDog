<local:BaseWindow x:Class="NotaDog.Windows.MenuWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:NotaDog.Windows"
                  mc:Ignorable="d"
                  MinHeight="400" MinWidth="600"
                  WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barre supérieure -->
            <!--Welcome-->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- Contenu principal -->
        </Grid.RowDefinitions>

        <!-- Barre supérieure -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" Margin="10">
            <Button Content="Paramètres" Margin="0 0 10 0" Click="SettingsButton_Click"/>
            <Button Content="Se déconnecter" Click="LogoutButton_Click"/>
        </StackPanel>
        
        <!-- Welcome -->
        <Label Grid.Row="1" x:Name="lblWelcome" Content="Bienvenue" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="16" Margin="0,0,0,0"/>

        <!-- Contenu principal -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des documents -->
            <GroupBox Header="Documents existants" Grid.Column="0" Margin="0,10,10,10">
                <ListBox x:Name="lstDocuments" />
            </GroupBox>

            <!-- Menu pour créer un nouveau document -->
            <GroupBox Header="Créer un nouveau document" Grid.Column="1" Margin="10,10,0,10">
                <StackPanel>
                    <Label Content="Type de document :" />
                    <ComboBox x:Name="cmbDocumentTypes" Width="150" Margin="0,5,0,0"/>
                    <Button Content="Créer" Width="100" Margin="0,10,0,0" Click="CreateDocumentButton_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</local:BaseWindow>
