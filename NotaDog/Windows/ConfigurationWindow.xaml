<local:BaseWindow x:Class="NotaDog.Windows.ConfigurationWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:NotaDog.Windows"
                  mc:Ignorable="d"
                  Title="{Binding Title}"
                  MinHeight="900" MinWidth="900">
    <Grid Margin="10">
        <!-- Define rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Scrollable content -->
            <RowDefinition Height="Auto"/>
            <!-- Confirm and Cancel buttons -->
        </Grid.RowDefinitions>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,10">
                <!-- Notary Settings -->
                <GroupBox Header="Information Notaire" Margin="0,0,0,10">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <!-- Define rows for Notary fields -->
                            <!-- We'll fill in the rows dynamically -->
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- First Row -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- First Name -->
                            <Label Content="Nom:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryFirstName" Margin="5,0,0,0" MinWidth="100"/>
                            <!-- Last Name -->
                            <Label Content="Prenom:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryLastName" Margin="5,0,0,0" MinWidth="100"/>
                            <!-- City -->
                            <Label Content="Ville:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryCity" Margin="5,0,0,0" MinWidth="100"/>
                            <!-- Country -->
                            <Label Content="Pays:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryCountry" Margin="5,0,0,0" MinWidth="100"/>
                        </StackPanel>

                        <!-- Second Row -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Office Name -->
                            <Label Content="Nom de L'etude:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryOfficeName" Margin="5,0,0,0" MinWidth="500"/>
                        </StackPanel>
                        <!-- Third Row -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- address -->
                            <Label Content="Adresse:" Margin="5,0,0,0" Width="auto"/>
                            <TextBox x:Name="txtNotaryOfficeAddress" Margin="5,0,0,0" MinWidth="500"/>
                        </StackPanel>

                        <!-- Case à cocher pour enregistrer les informations du notaire -->
                        <CheckBox x:Name="chkSaveNotaryInfo"
          Grid.Row="3"
          Content="Enregistrer ces informations pour la prochaine fois"
          Margin="5,0,0,0"
          HorizontalAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <!-- Separator and Document Title -->
                <Separator Margin="0,0,0,10"/>
                <TextBlock x:Name="txtDocumentTitle" Text="Erreur" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <!-- Document-Specific Content -->
                <ContentControl x:Name="MainContent"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirm and Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Confirm" Width="100" Margin="5" Click="ConfirmButton_Click"/>
            <Button Content="Cancel" Width="100" Margin="5" Click="CancelButton_Click"/>
            <!-- Nouvelle case à cocher -->
            <CheckBox x:Name="chkOpenAfterCreation" Content="Ouvrir le fichier après création" Margin="8"/>
        </StackPanel>
    </Grid>
</local:BaseWindow>
