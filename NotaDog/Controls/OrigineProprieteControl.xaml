<UserControl x:Class="NotaDog.Controls.OrigineProprieteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NotaDog.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding OwnershipOrigin, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <StackPanel Margin="10">
            <TextBlock Text="Origine de Propriété" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />

            <!-- Nom -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Nom :" Width="150" />
                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Prix -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Prix :" Width="150" />
                <TextBox Text="{Binding Price, Mode=TwoWay, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Objet -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Objet :" Width="150" />
                <TextBox Text="{Binding Objet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Numéro d'Objet -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Numéro d'Objet :" Width="150" />
                <TextBox Text="{Binding ObjetNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- place -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="A :" Width="150" />
                <TextBox Text="{Binding Place, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Date -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Date :" Width="150" />
                <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Lieu de Dépôt -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Lieu de Dépôt :" Width="150" />
                <TextBox Text="{Binding PlaceFiled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Date de Dépôt -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Date de Dépôt :" Width="150" />
                <DatePicker SelectedDate="{Binding DateFiled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Folio -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Folio :" Width="150" />
                <TextBox Text="{Binding Folio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

            <!-- Case -->
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Case :" Width="150" />
                <TextBox Text="{Binding Case, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="200" />
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
